# syntax=docker/dockerfile:1

# Behind a TLS-intercepting proxy (e.g. a corporate gateway), pass its root CA as a
# build secret instead of disabling certificate checks:
#   docker build --secret id=extra_ca,src=/path/to/root-ca.pem -f docker/Dockerfile.api .
# Without the secret the build uses the normal public CA bundle.

FROM node:22-alpine AS base

WORKDIR /app

# with-ca <command…>: runs a command trusting the optional extra CA (never persisted)
RUN printf '%s\n' \
  '#!/bin/sh' \
  'if [ -s /run/secrets/extra_ca ]; then' \
  '  cat /etc/ssl/certs/ca-certificates.crt /run/secrets/extra_ca > /tmp/ca-bundle.pem' \
  '  export SSL_CERT_FILE=/tmp/ca-bundle.pem NODE_EXTRA_CA_CERTS=/run/secrets/extra_ca npm_config_cafile=/tmp/ca-bundle.pem' \
  'fi' \
  '"$@"; status=$?' \
  'rm -f /tmp/ca-bundle.pem' \
  'exit $status' > /usr/local/bin/with-ca \
  && chmod +x /usr/local/bin/with-ca

FROM base AS builder

COPY package*.json ./
COPY apps/api/package*.json ./apps/api/
RUN --mount=type=secret,id=extra_ca,required=false \
  with-ca npm ci --workspace=apps/api --include-workspace-root --no-audit --no-fund \
  && npm cache clean --force

COPY tsconfig.json ./
COPY tsconfig.seed.json ./
COPY prisma.config.ts ./
COPY prisma ./prisma
COPY apps/api ./apps/api

RUN --mount=type=secret,id=extra_ca,required=false with-ca ./node_modules/.bin/prisma generate
RUN npm run build --workspace=apps/api
RUN npm run build:seed

FROM base AS runtime

ENV NODE_ENV=production

RUN --mount=type=secret,id=extra_ca,required=false \
  with-ca apk add --no-cache \
  openssl \
  py3-pillow \
  python3 \
  poppler-utils \
  tesseract-ocr \
  tesseract-ocr-data-dan \
  tesseract-ocr-data-eng

COPY package*.json ./
COPY apps/api/package*.json ./apps/api/
RUN --mount=type=secret,id=extra_ca,required=false \
  with-ca npm ci --omit=dev --omit=optional --workspace=apps/api --include-workspace-root --no-audit --no-fund \
  && npm cache clean --force

COPY prisma.config.ts ./
COPY prisma/schema.prisma ./prisma/schema.prisma
COPY prisma/migrations ./prisma/migrations
COPY prisma/receipt-training-seed.csv ./prisma/receipt-training-seed.csv
COPY apps/api/scripts ./apps/api/scripts
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/dist-seed ./dist-seed

# Fetch Prisma's schema engine at build time so container start (db push / migrate)
# needs no network access. The diff runs offline against the schema only.
RUN --mount=type=secret,id=extra_ca,required=false \
  DATABASE_URL=postgresql://build@localhost/build with-ca ./node_modules/.bin/prisma migrate diff \
  --from-empty --to-schema prisma/schema.prisma --script > /dev/null

COPY docker/entrypoint.sh ./entrypoint.sh
RUN chmod +x entrypoint.sh

EXPOSE 3001
CMD ["./entrypoint.sh"]
