FROM node:22-alpine AS base

WORKDIR /app

FROM base AS builder

COPY package*.json ./
COPY apps/api/package*.json ./apps/api/
RUN NPM_CONFIG_STRICT_SSL=false npm ci --workspace=apps/api --include-workspace-root --no-audit --no-fund \
  && npm cache clean --force

COPY tsconfig.json ./
COPY tsconfig.seed.json ./
COPY prisma.config.ts ./
COPY prisma ./prisma
COPY apps/api ./apps/api

RUN NODE_TLS_REJECT_UNAUTHORIZED=0 ./node_modules/.bin/prisma generate
RUN npm run build --workspace=apps/api
RUN npm run build:seed

FROM base AS runtime

ENV NODE_ENV=production

RUN apk add --no-cache \
  --no-check-certificate \
  ca-certificates \
  && update-ca-certificates \
  && apk add --no-cache \
  --no-check-certificate \
  openssl \
  py3-pillow \
  python3 \
  poppler-utils \
  tesseract-ocr \
  tesseract-ocr-data-dan \
  tesseract-ocr-data-eng

COPY package*.json ./
COPY apps/api/package*.json ./apps/api/
RUN NPM_CONFIG_STRICT_SSL=false npm ci --omit=dev --omit=optional --workspace=apps/api --include-workspace-root --no-audit --no-fund \
  && npm cache clean --force

COPY prisma.config.ts ./
COPY prisma/schema.prisma ./prisma/schema.prisma
COPY prisma/receipt-training-seed.csv ./prisma/receipt-training-seed.csv
COPY apps/api/scripts ./apps/api/scripts
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/dist-seed ./dist-seed

COPY docker/entrypoint.sh ./entrypoint.sh
RUN chmod +x entrypoint.sh

EXPOSE 3001
CMD ["./entrypoint.sh"]
