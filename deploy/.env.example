# ── Required ──────────────────────────────────────────────────────────────────
# Budgeteer will refuse to start if any of these are missing.

# Auth signing key — generate with: openssl rand -hex 32
JWT_SECRET=

# Internal database password (postgres is never exposed outside Docker)
POSTGRES_PASSWORD=

# Password for the admin account created on first boot
ADMIN_PASSWORD=

# ── Optional ──────────────────────────────────────────────────────────────────

# Admin account details
ADMIN_EMAIL=admin@budgeteer.local
ADMIN_NAME=Admin

# Port the web UI is served on
APP_PORT=7272

# The URL your browser uses to reach the app.
# Change this if you access Budgeteer via a hostname, IP, or reverse proxy.
# Example: http://192.168.1.10:7272  or  https://budget.yourdomain.com
PUBLIC_URL=http://localhost:7272

# Base currency for all calculations and display (DKK, EUR, USD, GBP, ...)
BASE_CURRENCY=DKK

# Encrypts stored secrets such as the SMTP password for email reminders — generate with: openssl rand -hex 32
# Without it a key is derived from JWT_SECRET, so changing JWT_SECRET means entering the SMTP password again.
SETTINGS_ENCRYPTION_KEY=

# Set to true to populate demo households on first boot
SEED_DEMO_DATA=false

# Keep API rate limiting enabled in production. Local dev compose disables it by default.
API_RATE_LIMIT_ENABLED=true
# API_RATE_LIMIT_MAX=200
# API_RATE_LIMIT_WINDOW=15 minutes

# Proxies trusted for the client IP used by rate limiting.
# Default: loopback + private networks (the bundled nginx and LAN reverse proxies).
# TRUST_PROXY=loopback,uniquelocal

# Schema sync mode on container startup: push, migrate, skip, or force-push.
# force-push enables Prisma --accept-data-loss and should only be used intentionally.
SCHEMA_SYNC_MODE=push

# Receipt OCR and local-only receipt AI (optional)
# RECEIPT_OCR_LANG=eng
# RECEIPT_OCR_MAX_PDF_PAGES=3
# RECEIPT_OCR_PDF_DPI=200
# RECEIPT_OCR_PSM=6
# RECEIPT_OCR_TIMEOUT_MS=45000
# RECEIPT_OCR_TOTAL_TIMEOUT_MS=120000
# RECEIPT_OCR_MAX_PIXELS=60000000
# LOCAL_AI_BASE_URL=http://ollama:11434
# LOCAL_AI_MODEL=
# RECEIPT_AI_CATEGORIZE=false

# AI Payslip Parsing — required for AI-assisted payslip import (optional feature)
# ANTHROPIC_API_KEY=
