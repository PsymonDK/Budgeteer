# Database
DATABASE_URL=postgresql://budgeteer:budgeteer@localhost:5432/budgeteer

# API
API_PORT=3001
JWT_SECRET=change-this-to-a-long-random-string
# Encrypts stored secrets such as the SMTP password (Admin → Notifications). Optional: without it a key
# is derived from JWT_SECRET, so changing JWT_SECRET means entering the SMTP password again.
# SETTINGS_ENCRYPTION_KEY=
# URL the browser uses to reach the app — used for CORS in Docker
PUBLIC_URL=http://localhost:7272
# Proxies trusted for the client IP (rate limiting). Default: loopback + private networks
# TRUST_PROXY=loopback,uniquelocal
# API rate limiting (on by default; the dev compose file turns it off)
# API_RATE_LIMIT_ENABLED=true
# API_RATE_LIMIT_MAX=200
# API_RATE_LIMIT_WINDOW=15 minutes
# Where avatars and receipt originals are stored (Docker mounts /app/uploads)
# UPLOAD_DIR=./uploads

# Docker builds behind a TLS-intercepting proxy: root CA (PEM) used only at build time
# EXTRA_CA_FILE=/path/to/corporate-root-ca.pem

# Seed — initial admin account created by `npm run db:seed`
ADMIN_EMAIL=admin@budgeteer.local
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Admin
# Set to true to seed demo households/users on first boot
SEED_DEMO_DATA=false

# Currency — base currency for all display and calculations (default: DKK)
BASE_CURRENCY=DKK

# Receipt OCR and local-only receipt AI (optional)
# RECEIPT_OCR_LANG=eng
# RECEIPT_OCR_MAX_PDF_PAGES=3
# RECEIPT_OCR_PDF_DPI=200
# RECEIPT_OCR_PSM=6
# RECEIPT_OCR_TIMEOUT_MS=45000
# RECEIPT_OCR_TOTAL_TIMEOUT_MS=120000
# RECEIPT_OCR_MAX_PIXELS=60000000
# LOCAL_AI_BASE_URL=http://localhost:11434
# LOCAL_AI_MODEL=
# RECEIPT_AI_CATEGORIZE=false

# AI Payslip Parsing — required for AI-assisted payslip import (optional feature)
# ANTHROPIC_API_KEY=
